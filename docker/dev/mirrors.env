# Mirror sources for offline / China network environment
# Source this file before running download.sh or docker build
#
# Usage:
#   source mirrors.env
#   bash download.sh
#
# To switch mirrors, edit this file — no need to touch scripts or Dockerfile.

# ---- APT ----
APT_MIRROR=mirrors.aliyun.com

# ---- Go ----
GO_MIRROR=https://mirrors.aliyun.com/golang

# ---- Node.js ----
NODE_MIRROR=https://mirrors.aliyun.com/nodejs-release

# ---- Docker CE (static binaries) ----
DOCKER_MIRROR=https://mirrors.aliyun.com/docker-ce/linux/static/stable/x86_64

# ---- npm ----
NPM_REGISTRY=https://registry.npmmirror.com/

# ---- PyPI (pip / uv) ----
PYPI_MIRROR=https://mirrors.aliyun.com/pypi/simple/

# ---- uv (Python package manager) ----
UV_VERSION=0.8.19

# ---- Coder CLI (from your Coder server) ----
CODER_DOWNLOAD_URL=https://coder.wyb.2wahaha.top/bin/coder-linux-amd64

# ---- Below are upstream URLs (no mirror, kept here for visibility) ----
# GVM:    https://github.com/moovweb/gvm
# NVM:    https://github.com/nvm-sh/nvm
# code-server: https://github.com/coder/code-server/releases
# VS Code: https://update.code.visualstudio.com
