# Terraform CLI 配置 — 使用本地文件系统镜像
# 挂载到 Coder server 容器: /home/coder/.terraformrc
# 或在 Coder server 启动时通过 CODER_TERRAFORM_MIRROR_DIR 指定

provider_installation {
  filesystem_mirror {
    path    = "/home/coder/providers"
    include = ["*/*/*"]
  }
  # 本地镜像命中后不再联网
  direct {
    exclude = ["*/*/*"]
  }
}
